{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnectionString": "Host=localhost;Database=Gastronomy;Port=5432;Username=postgres;Password=postgres;Include Error Detail=true;"
  },
  "IdentityModule": {
    "JwtTokenConfig": {
      "SecretKey": "your-256-bit-secret-key-here-must-be-long",
      "AccessTokenExpirationHours": 1,
      "RefreshTokenExpirationDays": 1,
      "Issuer": "Gastronomy1621",
      "Audience": "Gastronomy2732",
      "ClockSkewMinutes": 5
    },
    "PasswordConfig": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigits": true,
      "RequireSpecialCharacters": false,
      "WorkFactor": 12
    },
    "RegisterSmtpConfig": {
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 587,
      "SmtpCredentialAddress": "noreply@example.com",
      "SmtpCredentialPassword": "your_secure_password",
      "RegisterUrlTemplate": "/RegisterConfirm?token={0}",
      "MailSubject": "Подтверждение регистрации",
      "MailBodyTemplate": "<p>Здравствуйте!</p><p>Для завершения регистрации перейдите по ссылке: {0}</p>",
      "BodyTemplateReplacePrefix": "{"
    }
  },  
  "AllowedHosts": "*"
}
